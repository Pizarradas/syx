node_modules/
.sass-cache/
*.log

# `npm run build:css` corre `sass scss:css`, que replica TODO el árbol de
# parciales en css/ (css/atoms/, css/themes/bundle-*.css…). Solo los ocho
# puntos de entrada de css/ son entregables; el resto es subproducto de la
# compilación y ensuciaba `git status` en cada build.
css/abstracts/
css/atoms/
css/base/
css/layout/
css/molecules/
css/organisms/
css/site/
css/themes/
css/utilities/

# El sandbox de portabilidad genera spec/ y stories/ desde
# component-registry.json en cada `npm run generate`, y storybook-static/ es
# el build. Versionar derivados que se regeneran solos es invitar al drift:
# solo se versionan los generadores y la configuración.
storybook/spec/
storybook/stories/
storybook/storybook-static/
storybook/frameworks/*/src/
storybook/frameworks/*/stories/
storybook/frameworks/*/storybook-static/
storybook/portability-diffs/
storybook/portability-report.json

# La exportación DTCG son 2,9 MB derivables enteros de
# contracts/resolved-tokens.json. Se genera a demanda con
# `npm run export:tokens` y no se versiona: los datos derivados en un artefacto
# versionado se desfasan por su cuenta, y aquí además pesan más que todo el
# resto del repositorio junto.
contracts/dtcg/

# dist/ lo genera scripts/build-dist.js en `prepare` (npm pack, publish e
# instalación desde GitHub): hojas por contexto, minificadas, sin la capa site/.
# EXCEPTO dist/site/: lo que cargan home, docs, why-syx y theme-builder. Sin él
# versionado, abrir las páginas desde un clon (o servir la rama tal cual en
# Pages) las dejaba sin estilos hasta ejecutar `npm run build`.
# check-limpio --strict comprueba que lo commiteado es lo que sale de compilar.
dist/*
!dist/site/

# Pruebas en navegador: capturas y diferencias se regeneran en cada ejecución.
tests/browser/out/
tests/browser/out-paginas/
tests/browser/diferencias/

# Ejecuciones de scripts/eval-runner.js: transcripciones, respuestas y salida
# cruda de cada agente. Pesan, cambian en cada ejecución y pueden traer lo que
# el agente leyó. Solo se versiona el RESUMEN.md de cada una, que es lo que
# sirve para comparar un modo o un modelo con el anterior.
_agents/evals/runs/*/*
!_agents/evals/runs/*/RESUMEN.md
