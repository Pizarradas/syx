{
  "name": "syx-tests-browser",
  "private": true,
  "description": "Pruebas en navegador de SYX: axe sobre cada componente, tema y modo, y capturas para la regresión visual. No forma parte del paquete.",
  "type": "module",
  "scripts": {
    "axe": "node run.mjs --axe",
    "interaccion": "node interaccion.mjs",
    "capturas": "node run.mjs --capturas out",
    "paginas": "node paginas.mjs --capturas out-paginas",
    "comparar": "node comparar.mjs"
  },
  "devDependencies": {
    "axe-core": "^4.10.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0"
  }
}
