{
  "extends": [
    "stylelint-config-standard-scss"
  ],
  "reportDescriptionlessDisables": true,
  "reportNeedlessDisables": true,
  "rules": {
    "declaration-no-important": true,
    "declaration-block-no-duplicate-properties": [
      true,
      {
        "ignore": [
          "consecutive-duplicates-with-different-syntaxes"
        ]
      }
    ],
    "declaration-block-no-duplicate-custom-properties": true,
    "no-duplicate-selectors": true,
    "color-no-invalid-hex": true,
    "function-calc-no-unspaced-operator": true,
    "property-no-unknown": true,
    "unit-no-unknown": true,
    "scss/at-extend-no-missing-placeholder": true,
    "selector-class-pattern": null,
    "custom-property-pattern": null,
    "scss/dollar-variable-pattern": null,
    "scss/at-mixin-pattern": null,
    "scss/percent-placeholder-pattern": null,
    "scss/at-function-pattern": null,
    "keyframes-name-pattern": null,
    "comment-empty-line-before": null,
    "scss/double-slash-comment-empty-line-before": null,
    "rule-empty-line-before": null,
    "at-rule-empty-line-before": null,
    "declaration-empty-line-before": null,
    "custom-property-empty-line-before": null,
    "scss/dollar-variable-empty-line-before": null,
    "comment-whitespace-inside": null,
    "scss/comment-no-empty": null,
    "no-descending-specificity": null,
    "selector-not-notation": null,
    "color-function-notation": null,
    "alpha-value-notation": null,
    "hue-degree-notation": null,
    "lightness-notation": null,
    "color-hex-length": null,
    "length-zero-no-unit": null,
    "number-max-precision": null,
    "shorthand-property-no-redundant-values": null,
    "declaration-block-no-redundant-longhand-properties": null,
    "value-keyword-case": null,
    "font-family-name-quotes": null,
    "import-notation": null,
    "media-feature-range-notation": null,
    "selector-attribute-quotes": null,
    "scss/operator-no-newline-after": null,
    "scss/operator-no-unspaced": null,
    "scss/at-rule-conditional-no-parentheses": null,
    "scss/no-global-function-names": null,
    "scss/dollar-variable-colon-space-after": null,
    "scss/at-if-no-null": null,
    "scss/load-partial-extension": null,
    "scss/at-mixin-argumentless-call-parentheses": null,
    "scss/dollar-variable-empty-line-after": null,
    "scss/comment-no-loud": null,
    "declaration-property-value-no-unknown": null,
    "scss/declaration-property-value-no-unknown": null,
    "at-rule-no-unknown": null,
    "scss/at-rule-no-unknown": true,
    "property-no-vendor-prefix": null,
    "value-no-vendor-prefix": null,
    "selector-no-vendor-prefix": null,
    "media-feature-name-no-vendor-prefix": null,
    "font-family-no-missing-generic-family-keyword": null,
    "no-invalid-position-at-import-rule": null,
    "block-no-empty": null,
    "selector-pseudo-element-colon-notation": null,
    "declaration-block-single-line-max-declarations": null,
    "scss/at-else-closing-brace-newline-after": null,
    "scss/at-else-closing-brace-space-after": null,
    "scss/at-if-closing-brace-newline-after": null,
    "scss/at-if-closing-brace-space-after": null,
    "declaration-property-value-disallowed-list": [
      {
        "/^outline(-color)?$/": [
          "/--[a-z0-9-]*shadow[a-z0-9-]*/"
        ]
      },
      {
        "message": "Un token de sombra (*-shadow-*) no es un color: invalida el outline al calcularse y el foco desaparece. Usa @include focus-ring() o --semantic-focus-ring-color (Auditoría 2026-10 · acción 1)."
      }
    ],
    "property-disallowed-list": [
      [
        "/^(margin|padding|scroll-margin|scroll-padding)-(top|right|bottom|left)$/",
        "/^border-(top|right|bottom|left)(-(width|style|color))?$/",
        "/^(top|right|bottom|left)$/",
        "/^border-(top|bottom)-(left|right)-radius$/"
      ],
      {
        "message": "Propiedad física de lado: usa la lógica (margin-block-start, padding-inline-end, inset-inline-start, border-start-end-radius…) o los mixins margin()/padding()/position(), que ya la emiten. Si de verdad es física (un dibujo girado, un centrado con translate), exceptúala en la línea con `// stylelint-disable-next-line property-disallowed-list -- porqué` (Auditoría 2026-10 · acción 13)."
      }
    ],
    "declaration-property-value-allowed-list": [
      {
        "text-align": [
          "start",
          "end",
          "center",
          "justify",
          "match-parent",
          "inherit",
          "initial",
          "unset",
          "revert",
          "/^var\\(/"
        ],
        "/^(float|clear)$/": [
          "none",
          "both",
          "inline-start",
          "inline-end",
          "inherit",
          "initial",
          "unset",
          "revert",
          "/^var\\(/"
        ]
      },
      {
        "message": "text-align/float/clear con left o right es físico: usa start/end (inline-start/inline-end en float y clear), que siguen a la dirección del texto (Auditoría 2026-10 · acción 13)."
      }
    ]
  }
}
