{
  "name": "syx-design-system",
  "version": "4.28.0",
  "description": "A modern, token-driven SCSS design system built on Atomic Design principles. Ships its own contracts and an MCP server, so agents and apps can query it instead of reading it.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./themes/*.css": "./css/styles-theme-*.css",
    "./css/*": "./css/*",
    "./scss/*": "./scss/*",
    "./tokens.json": "./tokens.json",
    "./component-registry.json": "./component-registry.json",
    "./contracts/*": "./contracts/*",
    "./mcp": "./scripts/mcp-server.js"
  },
  "bin": {
    "syx-mcp": "scripts/mcp-server.js",
    "syx-scan": "scripts/scan-drift.js"
  },
  "files": [
    "index.js",
    "css/*.css",
    "scss/",
    "fonts/",
    "scripts/",
    "contracts/*.json",
    "contracts/validation-report.md",
    "tokens.json",
    "component-registry.json",
    "_agents/",
    "AGENTS.md",
    "CLAUDE.md",
    "AI_GUIDELINES.md",
    "THEMING-RULES.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pizarradas/syx.git"
  },
  "homepage": "https://github.com/pizarradas/syx#readme",
  "bugs": {
    "url": "https://github.com/pizarradas/syx/issues"
  },
  "scripts": {
    "start": "npm run watch",
    "build": "npm run build:css",
    "build:css": "sass scss:css --style=expanded --no-source-map && npm run postcss && npm run build:tokens",
    "watch": "sass --watch scss:css --style=expanded --no-source-map",
    "postcss": "postcss css/*.css --replace --no-map",
    "lint": "stylelint \"scss/**/*.scss\" --config .stylelintrc.json",
    "lint:fix": "stylelint \"scss/**/*.scss\" --config .stylelintrc.json --fix",
    "validate": "node scripts/syx-validate.js",
    "validate:report": "node scripts/syx-validate.js --report",
    "validate:strict": "node scripts/syx-validate.js --strict",
    "validate:tokens": "node scripts/validate-tokens.js",
    "validate:tokens:strict": "node scripts/validate-tokens.js --strict",
    "export:tokens": "node scripts/export-tokens.js",
    "check": "npm run validate:report && npm run check:themes && npm run check:version && npm run check:tokens && npm run check:huerfanos && npm run check:registry && npm run check:mcp && npm run check:escaner && npm run check:mixins && npm run check:modos && npm run check:encoding && npm run check:package && npm run build",
    "check:themes": "node scripts/check-theme-symmetry.js",
    "check:version": "node scripts/check-version.js",
    "build:tokens": "node scripts/build-token-snapshot.js",
    "check:tokens": "node scripts/build-token-snapshot.js --check",
    "check:huerfanos": "node scripts/check-huerfanos.js",
    "build:registry": "node scripts/build-component-registry.js",
    "check:registry": "node scripts/build-component-registry.js --check",
    "mcp": "node scripts/mcp-server.js",
    "check:mcp": "node scripts/check-mcp.js",
    "check:package": "node scripts/check-package.js",
    "check:consumible": "node scripts/check-consumible.js",
    "check:propuesta": "node scripts/check-propuesta.js",
    "propose": "node scripts/propose.js",
    "scan": "node scripts/scan-drift.js",
    "check:escaner": "node scripts/check-escaner.js",
    "check:limpio": "node scripts/check-limpio.js",
    "check:mixins": "node scripts/check-mixins.js",
    "check:modos": "node scripts/check-modos.js",
    "check:encoding": "node scripts/check-encoding.js",
    "fix:encoding": "node scripts/check-encoding.js --fix",
    "prepublishOnly": "npm run check && npm run check:consumible"
  },
  "keywords": [
    "design-system",
    "scss",
    "atomic-design",
    "tokens",
    "css-layers"
  ],
  "author": "Jos\u00e9 Luis Pizarro",
  "license": "MIT",
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "postcss-cli": "^11.0.0",
    "sass": "^1.77.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard-scss": "^13.0.0",
    "stylelint-order": "^6.0.0"
  },
  "browserslist": [
    "last 2 versions",
    "> 0.2%",
    "not dead"
  ]
}
