{
  "name": "syx-design-system",
  "version": "5.0.0",
  "description": "A modern, token-driven SCSS design system built on Atomic Design principles. Ships its own contracts and an MCP server, so agents and apps can query it instead of reading it.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./themes/*.css": "./dist/*.full.min.css",
    "./components.css": "./dist/syx.components.min.css",
    "./components/core.css": "./dist/syx.components.core.min.css",
    "./utilities.css": "./dist/syx.utilities.min.css",
    "./tokens/*.all.css": "./dist/*.tokens.all.min.css",
    "./tokens/*.css": "./dist/*.tokens.min.css",
    "./bundles/*": "./dist/*",
    "./css/*": "./css/*",
    "./scss/*": "./scss/*",
    "./js/syx-*.js": "./js/syx-*.js",
    "./tokens.json": "./tokens.json",
    "./component-registry.json": "./component-registry.json",
    "./contracts/*": "./contracts/*",
    "./mcp": "./scripts/mcp-server.js"
  },
  "bin": {
    "syx-mcp": "scripts/mcp-server.js",
    "syx-scan": "scripts/scan-drift.js",
    "syx-init": "scripts/init-app.js"
  },
  "files": [
    "index.js",
    "css/*.css",
    "dist/",
    "!dist/site/",
    "js/syx-*.js",
    "scss/",
    "fonts/",
    "scripts/",
    "contracts/*.json",
    "contracts/validation-report.md",
    "tokens.json",
    "component-registry.json",
    "_agents/",
    "templates/",
    "AGENTS.md",
    "CONSUMING.md",
    "CLAUDE.md",
    "AI_GUIDELINES.md",
    "THEMING-RULES.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css",
    "*.scss",
    "./js/*.js"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pizarradas/syx.git"
  },
  "homepage": "https://github.com/pizarradas/syx#readme",
  "bugs": {
    "url": "https://github.com/pizarradas/syx/issues"
  },
  "scripts": {
    "start": "npm run watch",
    "build": "npm run build:css && npm run build:docs-componentes && npm run build:dist",
    "build:css": "node scripts/build-css.js && npm run build:tokens && npm run build:tokens-json",
    "build:dist": "node scripts/build-dist.js",
    "watch": "sass --watch scss:css --style=expanded --no-source-map",
    "postcss": "postcss css/*.css --replace --no-map",
    "lint": "stylelint \"scss/**/*.scss\" --config .stylelintrc.json",
    "lint:fix": "stylelint \"scss/**/*.scss\" --config .stylelintrc.json --fix",
    "validate": "node scripts/syx-validate.js",
    "validate:report": "node scripts/syx-validate.js --report",
    "validate:strict": "node scripts/syx-validate.js --strict",
    "check:contratos": "node scripts/syx-validate.js --check",
    "check:reglas": "node scripts/check-reglas.js",
    "check:compilado": "node scripts/check-compilado.js",
    "export:tokens": "node scripts/export-tokens.js",
    "export:figma": "node scripts/export-figma.js",
    "check": "npm run lint && npm run check:contratos && npm run validate:report && npm run check:reglas && npm run check:compilado && npm run check:themes && npm run check:plantilla && npm run check:modo-claro && npm run check:contraste && npm run check:setups && npm run check:version && npm run check:tokens && npm run check:tokens-json && npm run check:huerfanos && npm run check:consumidores && npm run check:registry && npm run check:usage && npm run check:mcp && npm run check:colores && npm run check:capacidades && npm run check:escaner && npm run check:init-app && npm run check:clases-docs && npm run check:docs-componentes && npm run check:recuentos && npm run check:vitrina && npm run check:why-syx && npm run check:figma && npm run check:mixins && npm run check:clasificacion && npm run check:codeowners && npm run check:modos && npm run check:evals && npm run check:runner && npm run check:conocimiento && npm run check:encoding && npm run check:package && npm run check:soporte && npm run check:prepros && npm run check:pages && npm run build",
    "check:todo": "node scripts/check-todo.js",
    "check:themes": "node scripts/check-theme-symmetry.js --strict",
    "check:plantilla": "node scripts/check-plantilla.js",
    "theme:new": "node scripts/theme-new.js",
    "check:prepros": "node scripts/check-prepros.js",
    "check:pages": "node scripts/check-pages.js",
    "check:version": "node scripts/check-version.js",
    "build:tokens": "node scripts/build-token-snapshot.js",
    "check:tokens": "node scripts/build-token-snapshot.js --check",
    "build:tokens-json": "node scripts/build-tokens-json.js",
    "check:tokens-json": "node scripts/build-tokens-json.js --check",
    "check:huerfanos": "node scripts/check-huerfanos.js",
    "check:consumidores": "node scripts/check-consumidores.js",
    "build:registry": "node scripts/build-component-registry.js",
    "check:registry": "node scripts/build-component-registry.js --check",
    "check:usage": "node scripts/check-usage.js",
    "check:mutacion": "node scripts/check-mutacion.js",
    "mcp": "node scripts/mcp-server.js",
    "check:mcp": "node scripts/check-mcp.js",
    "check:colores": "node scripts/check-colores.js",
    "check:capacidades": "node scripts/check-capacidades.js",
    "check:package": "node scripts/check-package.js",
    "check:soporte": "node scripts/check-soporte.js",
    "check:consumible": "node scripts/check-consumible.js",
    "check:quickstart": "node scripts/check-quickstart.js",
    "check:propuesta": "node scripts/check-propuesta.js",
    "propose": "node scripts/propose.js",
    "scan": "node scripts/scan-drift.js",
    "check:escaner": "node scripts/check-escaner.js",
    "init-app": "node scripts/init-app.js",
    "check:init-app": "node scripts/check-init-app.js",
    "check:clases-docs": "node scripts/check-clases-docs.js",
    "check:limpio": "node scripts/check-limpio.js",
    "check:mixins": "node scripts/check-mixins.js",
    "check:figma": "node scripts/export-figma.js --check",
    "check:evals": "node scripts/check-evals.js",
    "eval:modo": "node scripts/eval-modo.js",
    "eval:runner": "node scripts/eval-runner.js",
    "check:runner": "node scripts/check-runner.js",
    "test:navegador": "npm --prefix tests/browser ci && node tests/browser/run.mjs --axe && node tests/browser/interaccion.mjs && node tests/browser/foco.mjs && node tests/browser/reflow.mjs && node tests/browser/sitio.mjs",
    "check:modos": "node scripts/check-modos.js",
    "check:encoding": "node scripts/check-encoding.js",
    "fix:encoding": "node scripts/check-encoding.js --fix",
    "prepublishOnly": "npm run check && npm run check:consumible",
    "check:setups": "node scripts/check-setups.js",
    "check:modo-claro": "node scripts/check-modo-claro.js",
    "check:contraste": "node scripts/check-contraste.js",
    "check:conocimiento": "node scripts/check-conocimiento.js",
    "prepare": "node scripts/build-dist.js --quiet",
    "check:vitrina": "node scripts/scan-drift.js home.html docs.html why-syx.html theme-builder.html --fallar-si-media --ignorar primitivo-en-app,pinta-clase-syx,movimiento-sin-salida",
    "build:why-syx": "node scripts/build-why-syx.js",
    "check:why-syx": "node scripts/build-why-syx.js --check",
    "check:clasificacion": "node scripts/check-clasificacion.js",
    "build:codeowners": "node scripts/build-codeowners.js",
    "check:codeowners": "node scripts/build-codeowners.js --check",
    "check:confianza": "node scripts/check-confianza.js",
    "build:docs-componentes": "node scripts/build-docs-componentes.js",
    "check:docs-componentes": "node scripts/build-docs-componentes.js --check",
    "check:recuentos": "node scripts/check-recuentos.js",
    "fix:recuentos": "node scripts/check-recuentos.js --fix"
  },
  "keywords": [
    "design-system",
    "scss",
    "atomic-design",
    "tokens",
    "css-layers"
  ],
  "author": "José Luis Pizarro",
  "license": "MIT",
  "dependencies": {
    "postcss": "^8.4.38",
    "postcss-scss": "^4.0.9"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "postcss-cli": "^11.0.0",
    "sass": "^1.77.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard-scss": "^13.0.0",
    "stylelint-no-unsupported-browser-features": "^8.1.2",
    "stylelint-order": "^6.0.0"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 121",
    "safari >= 16.2",
    "ios_saf >= 16.2"
  ]
}
